{
  "name": "catalogue-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prestart": "npm run build",
    "start": "vite preview --host --port 5173",
    "preview": "vite preview --host --port 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
