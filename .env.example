# Copy to .env: cp .env.example .env
# All values below have matching defaults in backend/src/config.ts.

# Backend listen port
PORT=3001

# Comma-separated Fake Store product IDs shown on the home page
FEATURED_PRODUCT_IDS=1,2,3,4,5

# Product data source — swap this (and the adapter in backend/src/index.ts) to change source
FAKE_STORE_BASE_URL=https://fakestoreapi.com

# Sales inbox that receives enquiry emails
SALES_EMAIL=sales@example.com

# Allowed frontend origin
CORS_ORIGIN=http://localhost:5173

# SMTP — MailHog defaults. Leave USER/PASS empty for local MailHog.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
